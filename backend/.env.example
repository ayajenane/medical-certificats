PORT=5000
MONGODB_URI=mongodb://localhost:27017/dashboard-app

# Secret de signature JWT. Générer une valeur forte et unique par environnement, par ex. :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Le serveur refuse de démarrer si cette variable est absente ou laissée à une valeur par défaut connue.
JWT_SECRET=

NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Utilisés uniquement par scripts/seedAdmin.js pour créer le premier compte superadmin
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=superadmin@dgac.ma
SUPER_ADMIN_PASSWORD=
